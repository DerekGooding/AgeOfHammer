<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The Godot .NET packages ship with the editor (tools/get-godot.ps1); nuget.org is the fallback. -->
    <add key="godot-local" value="../tools/godot/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
